# Frontend environment — copy to .env and fill in your values
# Vite exposes only VITE_* variables to the browser

# WebSocket URL of your NestJS backend
# local:  ws://localhost:8000
# ngrok:  wss://xxxx.ngrok-free.app  (note: wss for https ngrok URLs)
VITE_WS_URL=ws://localhost:8000

# REST API base URL (for teacher dashboard REST calls)
VITE_API_URL=http://localhost:8000
