PORT=8000
NODE_ENV=development

# JWT
JWT_SECRET=change-this-min-32-chars-random-string
JWT_EXPIRES=30d

# Your friend's LLM — OpenAI-compatible endpoint
# e.g. Ollama: http://localhost:11434
# e.g. vLLM:   http://server:8000
# e.g. ngrok:  https://xxxx.ngrok-free.app
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_MODEL=llama3

# CORS — your frontend URL
ALLOWED_ORIGINS=http://localhost:5173
