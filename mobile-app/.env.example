# TalimZ Environment Variables
# Copy this file to .env and fill in your actual values

# Gemini AI API Key (get from https://makersuite.google.com/)
GEMINI_API_KEY=your_actual_gemini_api_key_here

# WebSocket AI Server URL (optional - for custom AI server)
WEBSOCKET_SERVER_URL=ws://localhost:8765

# App Configuration
APP_VERSION=1.0.0
DEBUG_MODE=false